{
    "manifest_version": 3,
    "name": "Smart Job Answer Generator",
    "version": "1.0",
    "permissions": ["storage", "scripting", "activeTab", "clipboardWrite"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icon.png"
    },
    
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ]
  }
  